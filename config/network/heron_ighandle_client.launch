<launch>
  <!-- Heron contributes MCU, Wi-Fi, and GPS hardware to IGHandle's ROS graph.
       DLiO, robot state, map correction, and autonomous commands are owned on
       IGHandle. Handheld RC remains inside the Heron MCU path. -->
  <arg name="namespace" value="$(optenv ROBOT_NAMESPACE)"/>

  <group ns="/$(arg namespace)">
    <arg name="port" default="/dev/arduino"/>
    <arg name="baud" default="115200"/>
    <node pkg="rosserial_python" type="serial_node.py" name="rosserial_server">
      <param name="port" value="$(arg port)"/>
      <param name="baud" value="$(arg baud)"/>
      <!-- The IGHandle command owner publishes this session heartbeat. The
           wireless watcher remains diagnostic and does not authorize drive. -->
      <remap from="has_wifi" to="/has_wifi"/>
    </node>
    <node pkg="rosserial_python" type="message_info_service.py"
          name="rosserial_message_info"/>

    <group if="$(optenv USE_SNMP_CHECK_NODE true)">
      <node pkg="heron_base" type="snmp_lights.py" name="wifi_lights">
        <param name="~ip_addr" value="$(optenv SNMP_IP 192.168.1.9)"/>
      </node>
    </group>
    <group unless="$(optenv USE_SNMP_CHECK_NODE true)">
      <node ns="wireless" pkg="wireless_watcher" name="wireless_watcher"
            type="watcher_node" respawn="true"/>
    </group>

    <group ns="navsat">
      <node pkg="nmea_comms" type="serial_node" name="nmea_serial_node">
        <param name="port" value="$(optenv HERON_NAVSAT_UBLOX_PORT /dev/ublox)"/>
        <param name="baud" value="$(optenv HERON_NAVSAT_UBLOX_BAUD 115200)"/>
        <param name="frame_id" value="$(eval 'navsat_link' if arg('namespace') == '' else arg('namespace') + '/navsat_link')"/>
      </node>
      <node pkg="nmea_comms" type="socket_node" name="nmea_socket_node"
            if="$(optenv HERON_NAVSAT_UBLOX_SOCKET 0)">
        <param name="port" value="$(optenv HERON_NAVSAT_UBLOX_SOCKET_PORT 2525)"/>
        <remap from="tx" to="rx"/>
      </node>
      <node pkg="nmea_navsat_driver" type="nmea_topic_driver"
            name="nmea_topic_driver"/>
    </group>
  </group>
</launch>

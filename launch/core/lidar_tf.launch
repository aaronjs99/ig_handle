<launch>
  <arg name="config_file" default="$(find ig_handle)/config/lidar_pair_extrinsics.yaml"/>

  <!-- Static TF between lidar_h_link and lidar_v_link. The values live in YAML
       so calibration tools can update data without rewriting launch XML. -->
  <node pkg="ig_handle"
        type="lidar_pair_tf_broadcaster.py"
        name="lidar_pair_tf_broadcaster"
        output="screen">
    <param name="config_file" value="$(arg config_file)"/>
  </node>
</launch>

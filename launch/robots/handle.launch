<launch>
  <!-- Start rosserial -->
  <include file="$(find ig_handle)/launch/core/start_rosserial.launch" />

  <!-- Start IMU -->
  <include file="$(find ig_handle)/launch/sensors/start_imu.launch" />

  <!-- Start lidar -->
  <include file="$(find ig_handle)/launch/sensors/start_lidar.launch">
      <arg name="name" value="lidar_h" />
      <arg name="device_ip" value="192.168.1.201" />
      <arg name="port" value="2368" />
      <arg name="frame_id" value="lidar_h_link" />
  </include>

  <!-- Start cameras -->
  <!--  <include file="$(find ig_handle)/launch/sensors/start_cam.launch">
      <arg name="camera_name" value="F1" />
      <arg name="camera_serial" value="22181623" />
  </include>
  <include file="$(find ig_handle)/launch/sensors/start_cam.launch">
      <arg name="camera_name" value="F2" />
      <arg name="camera_serial" value="22181616" />
  </include> -->
</launch>

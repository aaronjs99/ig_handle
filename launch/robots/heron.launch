<launch>
  <!-- Primary boat adapter. Actuation is handled downstream by the Heron
       computer; this launcher owns the shared IG sensor suite. -->
  <arg name="use_cameras" default="true"/>
  <arg name="use_lidar_h" default="true"/>
  <arg name="use_lidar_v" default="true"/>
  <arg name="use_sonar" default="true"/>
  <arg name="use_teensy" default="false"/>

  <arg name="topic_imu"        default="/sensors/imu/data"/>
  <arg name="topic_lidar_h"    default="/sensors/lidar/hori/points"/>
  <arg name="topic_lidar_v"    default="/sensors/lidar/vert/points"/>
  <arg name="topic_cam_f1_raw" default="/sensors/camera/f1/image_raw"/>
  <arg name="topic_cam_f2_raw" default="/sensors/camera/f2/image_raw"/>
  <arg name="topic_cam_f3_raw" default="/sensors/camera/f3/image_raw"/>
  <arg name="topic_cam_f4_raw" default="/sensors/camera/f4/image_raw"/>
  <arg name="topic_sonar_raw"  default="/sensors/sonar/raw"/>
  <arg name="topic_sonar"      default="/sensors/sonar/scan"/>
  <arg name="topic_pps_time"   default="/sensors/pps/time"/>
  <arg name="topic_camera_time" default="/sensors/camera/time"/>
  <arg name="camera_f1_info_url" default="package://slam_grande/config/flir_left.yaml"/>
  <arg name="camera_f2_info_url" default="package://slam_grande/config/flir_right.yaml"/>

  <include file="$(find ig_handle)/launch/robots/sensor_suite.launch">
    <arg name="use_cameras" value="$(arg use_cameras)"/>
    <arg name="use_lidar_h" value="$(arg use_lidar_h)"/>
    <arg name="use_lidar_v" value="$(arg use_lidar_v)"/>
    <arg name="use_sonar" value="$(arg use_sonar)"/>
    <arg name="use_teensy" value="$(arg use_teensy)"/>
    <arg name="topic_imu" value="$(arg topic_imu)"/>
    <arg name="topic_lidar_h" value="$(arg topic_lidar_h)"/>
    <arg name="topic_lidar_v" value="$(arg topic_lidar_v)"/>
    <arg name="topic_cam_f1_raw" value="$(arg topic_cam_f1_raw)"/>
    <arg name="topic_cam_f2_raw" value="$(arg topic_cam_f2_raw)"/>
    <arg name="topic_cam_f3_raw" value="$(arg topic_cam_f3_raw)"/>
    <arg name="topic_cam_f4_raw" value="$(arg topic_cam_f4_raw)"/>
    <arg name="topic_sonar_raw" value="$(arg topic_sonar_raw)"/>
    <arg name="topic_sonar" value="$(arg topic_sonar)"/>
    <arg name="topic_pps_time" value="$(arg topic_pps_time)"/>
    <arg name="topic_camera_time" value="$(arg topic_camera_time)"/>
    <arg name="camera_f1_info_url" value="$(arg camera_f1_info_url)"/>
    <arg name="camera_f2_info_url" value="$(arg camera_f2_info_url)"/>
  </include>
</launch>

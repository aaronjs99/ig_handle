<launch>
  <!-- Shared IG Handle sensor suite. Platform launchers should include this
       file instead of copying sensor wiring. -->
  <arg name="use_cameras" default="true"/>
  <arg name="use_cameras_f1f2" default="$(arg use_cameras)"/>
  <arg name="use_cameras_f3f4" default="$(arg use_cameras)"/>
  <arg name="use_lidar_h" default="true"/>
  <arg name="use_lidar_v" default="true"/>
  <arg name="use_sonar" default="true"/>
  <arg name="use_thermal" default="false"/>
  <arg name="use_teensy" default="false"/>

  <arg name="topic_imu"        default="/sensors/imu/data"/>
  <arg name="topic_lidar_h"    default="/sensors/lidar/hori/points"/>
  <arg name="topic_lidar_v"    default="/sensors/lidar/vert/points"/>
  <arg name="topic_cam_f1_raw" default="/sensors/camera/f1/image_raw"/>
  <arg name="topic_cam_f2_raw" default="/sensors/camera/f2/image_raw"/>
  <arg name="topic_cam_f3_raw" default="/sensors/camera/f3/image_raw"/>
  <arg name="topic_cam_f4_raw" default="/sensors/camera/f4/image_raw"/>
  <arg name="topic_sonar"      default="/sensors/sonar/scan"/>
  <arg name="topic_thermal"    default="/sensors/thermal/image_raw"/>
  <arg name="camera_f1_info_url" default="package://slam_grande/config/flir_left.yaml"/>
  <arg name="camera_f2_info_url" default="package://slam_grande/config/flir_right.yaml"/>

  <include if="$(arg use_teensy)" file="$(find ig_handle)/launch/core/start_rosserial.launch"/>

  <include file="$(find ig_handle)/launch/sensors/start_imu.launch">
    <arg name="topic" value="$(arg topic_imu)"/>
  </include>

  <include if="$(arg use_lidar_h)" file="$(find ig_handle)/launch/sensors/start_lidar.launch">
    <arg name="name"      value="hori"/>
    <arg name="device_ip" value="192.168.50.201"/>
    <arg name="port"      value="2368"/>
    <arg name="frame_id"  value="lidar_h_link"/>
    <arg name="topic"     value="$(arg topic_lidar_h)"/>
  </include>

  <include if="$(arg use_lidar_v)" file="$(find ig_handle)/launch/sensors/start_lidar.launch">
    <arg name="name"      value="lidar_v"/>
    <arg name="device_ip" value="192.168.50.202"/>
    <arg name="port"      value="2369"/>
    <arg name="frame_id"  value="lidar_v_link"/>
    <arg name="topic"     value="$(arg topic_lidar_v)"/>
  </include>

  <include if="$(arg use_sonar)" file="$(find ig_handle)/launch/sensors/start_sonar.launch">
    <arg name="topic" value="$(arg topic_sonar)"/>
  </include>

  <group if="$(arg use_cameras_f1f2)">
    <include file="$(find ig_handle)/launch/sensors/start_cam.launch">
      <arg name="camera_name"     value="F1"/>
      <arg name="frame_id"        value="F1_optical"/>
      <arg name="camera_serial"   value="25110056"/>
      <arg name="camera_info_url" value="$(arg camera_f1_info_url)"/>
      <arg name="topic"           value="$(arg topic_cam_f1_raw)"/>
    </include>
    <include file="$(find ig_handle)/launch/sensors/start_cam.launch">
      <arg name="camera_name"     value="F2"/>
      <arg name="frame_id"        value="F2_optical"/>
      <arg name="camera_serial"   value="25152257"/>
      <arg name="camera_info_url" value="$(arg camera_f2_info_url)"/>
      <arg name="topic"           value="$(arg topic_cam_f2_raw)"/>
    </include>
  </group>

  <group if="$(arg use_cameras_f3f4)">
    <include file="$(find ig_handle)/launch/sensors/start_cam.launch">
      <arg name="camera_name"   value="F3"/>
      <arg name="camera_serial" value="25110061"/>
      <arg name="topic"         value="$(arg topic_cam_f3_raw)"/>
    </include>
    <include file="$(find ig_handle)/launch/sensors/start_cam.launch">
      <arg name="camera_name"   value="F4"/>
      <arg name="camera_serial" value="25110065"/>
      <arg name="topic"         value="$(arg topic_cam_f4_raw)"/>
    </include>
  </group>

  <include if="$(arg use_thermal)" file="$(find ig_handle)/launch/sensors/start_thermal.launch">
    <arg name="topic" value="$(arg topic_thermal)"/>
  </include>
</launch>

<launch>
  <arg name="sensor_contract_file" default="$(find ig_handle)/config/sensors/sensor_contract.yaml"/>
  <arg name="extra_sensor_ids" default=""/>
  <arg name="disabled_sensor_ids" default=""/>
  <arg name="sensor_reachability_check" default="true"/>
  <arg name="external_sensor_profile" default="integrated"/>
  <arg name="use_external_sensor_provider" default="false"
       doc="Own the integrated Xsens provider in this launch; exclude any separate provider first."/>

  <node if="$(arg use_external_sensor_provider)"
        pkg="ig_handle" type="external_sensor_provider.py"
        name="external_sensor_provider_1" output="screen" required="true"
        args="--sensor-id 1 --profile $(arg external_sensor_profile) --sensor-contract-file '$(arg sensor_contract_file)'"/>

  <node pkg="ig_handle"
        type="sensor_bringup.py"
        name="sensor_bringup"
        output="screen"
        required="true">
    <param name="sensor_contract_file" value="$(arg sensor_contract_file)"/>
    <param name="extra_sensor_ids" value="$(arg extra_sensor_ids)"/>
    <param name="disabled_sensor_ids" value="$(arg disabled_sensor_ids)"/>
    <param name="sensor_reachability_check" value="$(arg sensor_reachability_check)"/>
  </node>
</launch>

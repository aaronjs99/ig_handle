<launch>
  <arg name="name"      default="velodyne" />
  <arg name="device_ip" default="" />
  <arg name="port"      default="2368" />
  <arg name="frame_id"  default="velodyne" />
  <arg name="topic"     default="velodyne_points" />
  <arg name="gps_time"  default="false" />
  <arg name="laserscan" default="false"
       doc="Set true to enable the laserscan nodelet (unused by DLIO)" />

  <group ns="$(arg name)">
    <!-- Manager + driver + transform -->
    <include file="$(find velodyne_driver)/launch/nodelet_manager.launch">
      <arg name="device_ip" value="$(arg device_ip)"/>
      <arg name="frame_id"  value="$(arg frame_id)"/>
      <arg name="manager"   value="$(arg frame_id)_nodelet_manager"/>
      <arg name="model"     value="VLP16"/>
      <arg name="port"      value="$(arg port)"/>
      <arg name="gps_time"  value="$(arg gps_time)"/>
    </include>

    <include file="$(find velodyne_pointcloud)/launch/transform_nodelet.launch">
      <arg name="model"       value="VLP16"/>
      <arg name="calibration" value="$(find velodyne_pointcloud)/params/VLP16db.yaml"/>
      <arg name="manager"     value="$(arg frame_id)_nodelet_manager"/>
      <arg name="fixed_frame" value=""/>
      <arg name="target_frame" value=""/>
    </include>

    <!-- Remap the output points to the desired modular topic -->
    <!-- Usually velodyne transform nodelet publishes to velodyne_points in the namespace -->
    <node pkg="topic_tools" type="relay" name="points_relay" 
          args="velodyne_points $(arg topic)" />

    <!-- Laserscan nodelet (optional) -->
    <include if="$(arg laserscan)"
             file="$(find velodyne_pointcloud)/launch/laserscan_nodelet.launch">
      <arg name="manager" value="$(arg frame_id)_nodelet_manager"/>
    </include>
  </group>
</launch>

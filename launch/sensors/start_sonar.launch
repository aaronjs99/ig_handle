<!-- ig_handle/launch/sensors/start_sonar.launch -->
<launch>
  <arg name="use_vm"         default="false"/>
  <arg name="bridge_adapter" default="br0"/>
  <arg name="headless"       default="false"/>
  <arg name="driver_mode"    default="dt100"/>
  <arg name="udp_port"/>
  <arg name="raw_topic"/>
  <arg name="dt100_frame"/>
  <arg name="dt100_extrinsic_revision"/>
  <arg name="ping360_frame"/>
  <arg name="ping360_extrinsic_revision"/>
  <arg name="unverified_frame"/>
  <arg name="unverified_extrinsic_revision"/>
  <arg name="ping360_raw_topic" default="/sensors/sonar/ping360/raw"/>
  <arg name="profile_topic" default="/sensors/sonar/imaging/profile"/>
  <arg name="diagnostics_topic" default="/sensors/sonar/ping360/diagnostics"/>
  <arg name="operation_mode" default="identity"/>
  <arg name="allow_active_transmit" default="false"/>
  <arg name="sound_speed_mps" default="1480.0"/>
  <arg name="sensor_id"/>
  <!-- The lifecycle owner resolves and validates every provider value before
       including this leaf launch. Direct invocation therefore fails closed
       unless the complete admission bundle is supplied explicitly. -->
  <arg name="dt100_hardware_commissioned"/>
  <arg name="dt100_expected_udp_source_ip"/>
  <arg name="dt100_expected_udp_source_port"/>
  <arg name="bind_ip"/>
  <arg name="sonar_ip"/>
  <arg name="udp_dest_ip"/>
  <arg name="sonar_reachable"/>
  <arg name="sonar_profile"/>
  <arg name="sonar_profile_config"/>
  <arg name="verbose_deltat_ini" default="false"/>

  <param name="/ig_handle/sensors/$(arg sensor_id)/reachable" value="$(arg sonar_reachable)"/>

  <group if="$(arg sonar_reachable)">
  <!-- DT100 native path: Linux_DeltaT talks to the sonar head and forwards
       DT100 UDP packets to this ROS host. If use_vm=true, the Windows
       VM/DT100.exe path provides that UDP stream instead. For unknown/new
       sonar models, driver_mode=udp_raw starts only the raw receiver so bags
       preserve whatever UDP datagrams arrive on the configured port. -->
    <node if="$(eval str(arg('driver_mode')).lower() == 'dt100' and str(arg('use_vm')).lower() == 'false' and str(arg('dt100_hardware_commissioned')).lower() == 'true' and bool(str(arg('dt100_expected_udp_source_ip')).strip()))"
          pkg="ig_handle" type="provider.py" name="deltat_tx" output="log"
          args="deltat --profile-config $(arg sonar_profile_config) --profile $(arg sonar_profile) --sonar-ip $(arg sonar_ip) --udp-ip $(arg udp_dest_ip) --udp-port $(arg udp_port)">
      <env name="VERBOSE" value="$(arg verbose_deltat_ini)"/>
    </node>

  <!-- Windows VM path: keep this available for systems that still need DT100.exe. -->
    <group if="$(eval str(arg('driver_mode')).lower() == 'dt100' and str(arg('use_vm')).lower() == 'true' and str(arg('dt100_hardware_commissioned')).lower() == 'true' and bool(str(arg('dt100_expected_udp_source_ip')).strip()))">
      <node pkg="dt100_driver" type="dt100_vm.bash" name="dt100_vm_node" output="log">
        <param name="bridge_adapter" value="$(arg bridge_adapter)"/>
        <param name="headless" value="$(arg headless)"/>
      </node>
    </group>

  <!-- Unknown passive UDP capture remains available as unverified evidence.
       The DT100-labelled path stays absent until hardware commissioning is
       explicit and then rejects every unexpected UDP source IP/port. -->
    <node if="$(eval str(arg('driver_mode')).lower() == 'udp_raw' or (str(arg('driver_mode')).lower() == 'dt100' and str(arg('dt100_hardware_commissioned')).lower() == 'true' and bool(str(arg('dt100_expected_udp_source_ip')).strip())))"
          pkg="ig_handle" type="provider.py" name="sonar_raw_receiver" output="log" args="receiver">
      <param name="port" value="$(arg udp_port)"/>
      <param name="topic" value="$(arg raw_topic)"/>
      <param name="bind_ip" value="$(arg bind_ip)"/>
      <param name="provider" value="$(eval 'imagenex_dt100' if str(arg('driver_mode')).lower() == 'dt100' else 'unverified_udp')"/>
      <param name="model" value="$(eval 'Imagenex DT100' if str(arg('driver_mode')).lower() == 'dt100' else 'unverified')"/>
      <param name="hardware_commissioned" value="$(eval str(arg('driver_mode')).lower() == 'dt100' and str(arg('dt100_hardware_commissioned')).lower() == 'true')"/>
      <param name="require_expected_source" value="$(eval str(arg('driver_mode')).lower() == 'dt100')"/>
      <param name="expected_source_ip" value="$(eval arg('dt100_expected_udp_source_ip') if str(arg('driver_mode')).lower() == 'dt100' else '')"/>
      <param name="expected_source_port" value="$(eval arg('dt100_expected_udp_source_port') if str(arg('driver_mode')).lower() == 'dt100' else '0')"/>
      <param name="frame_id" value="$(eval arg('dt100_frame') if str(arg('driver_mode')).lower() == 'dt100' else arg('unverified_frame'))"/>
      <param name="extrinsic_revision" value="$(eval arg('dt100_extrinsic_revision') if str(arg('driver_mode')).lower() == 'dt100' else arg('unverified_extrinsic_revision'))"/>
    </node>

  <!-- Ping360 is active request/reply even in read-only identity mode. Scanning
       is rejected unless both operation_mode=scan and allow_active_transmit=true. -->
    <node if="$(eval str(arg('driver_mode')).lower() == 'ping360')"
          pkg="ig_handle" type="provider.py" name="ping360_provider" output="screen" args="ping360">
      <param name="host" value="$(arg sonar_ip)"/>
      <param name="port" value="$(arg udp_port)"/>
      <param name="bind_ip" value="$(arg bind_ip)"/>
      <param name="raw_topic" value="$(arg ping360_raw_topic)"/>
      <param name="profile_topic" value="$(arg profile_topic)"/>
      <param name="diagnostics_topic" value="$(arg diagnostics_topic)"/>
      <param name="operation_mode" value="$(arg operation_mode)"/>
      <param name="allow_active_transmit" value="$(arg allow_active_transmit)"/>
      <param name="sound_speed_mps" value="$(arg sound_speed_mps)"/>
      <param name="frame_id" value="$(arg ping360_frame)"/>
      <param name="extrinsic_revision" value="$(arg ping360_extrinsic_revision)"/>
    </node>
  </group>
</launch>

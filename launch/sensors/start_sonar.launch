<!-- ig_handle/launch/sensors/start_sonar.launch -->
<launch>
  <arg name="use_vm"         default="false"/>
  <arg name="bridge_adapter" default="br0"/>
  <arg name="headless"       default="false"/>
  <arg name="udp_port"       default="4040"/>
  <arg name="raw_topic"      default="/sensors/sonar/raw"/>
  <arg name="cloud_topic"    default="/sensors/sonar/scan"/>
  <arg name="frame_id"       default="sonar_link"/>
  <arg name="bind_ip"        default="0.0.0.0"/>
  <arg name="udp_dest_ip"    default="192.168.0.3"/>

  <node pkg="ig_handle" type="run_deltat.sh" name="deltat_tx" output="log"
        args="$(arg udp_dest_ip) $(arg udp_port)" />

  <!-- Option A: legacy VM + relay (only if use_vm=true) -->
  <group if="$(arg use_vm)">
    <node pkg="dt100_driver" type="dt100_vm.bash" name="dt100_vm_node" output="log">
      <param name="bridge_adapter" value="$(arg bridge_adapter)"/>
      <param name="headless" value="$(arg headless)"/>
    </node>

  </group>

  <!-- Common: keep DT100 bytes raw, then publish a typed PointCloud2 adapter. -->
  <node pkg="ig_handle" type="dt100_rx.py" name="dt100_raw_driver" output="log">
    <param name="port" value="$(arg udp_port)"/>
    <param name="topic" value="$(arg raw_topic)"/>
    <param name="bind_ip" value="$(arg bind_ip)"/>
  </node>

  <node pkg="ig_handle" type="dt100_profile_to_cloud.py" name="dt100_profile_to_cloud" output="screen">
    <param name="raw_topic" value="$(arg raw_topic)"/>
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
  </node>
</launch>

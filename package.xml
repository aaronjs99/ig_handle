<?xml version="1.0"?>
<package format="3">
  <name>ig_handle</name>
  <version>1.0.1</version>
  <description>Physical sensor, timing, networking, and raw-acquisition interfaces for GRANDE.</description>

  <author email="aaronjs@g.ucla.edu">Aaron John Sabu</author>
  <author email="adthoms@ucla.edu">Alexander Thoms</author>
  <author email="gearle@uwaterloo.ca">Gabriel Earle</author>
  <maintainer email="aaronjs@g.ucla.edu">Aaron John Sabu</maintainer>
  <maintainer email="adthoms@ucla.edu">Alex Thoms</maintainer>
  <maintainer email="gearle@uwaterloo.ca">Gabe Earle</maintainer>

  <license>MIT</license>
  <url type="repository">https://github.com/aaronjs99/ig_handle</url>
  <url type="bugtracker">https://github.com/aaronjs99/ig_handle/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>ament_index_python</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>heron_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf_transformations</depend>
  <depend>tf2_ros</depend>
  <depend>xsens_mti_ros2_driver</depend>
  <exec_depend>dt100_driver</exec_depend>
  <exec_depend>python3-dbus</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-usb</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

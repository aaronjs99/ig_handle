[Unit]
Description=Persistent serial-qualified GRANDE Xsens IMU provider
Requires=ig-handle-roscore-user.service
BindsTo=ig-handle-roscore-user.service
PartOf=ig-handle-roscore-user.service
After=network-online.target ig-handle-roscore-user.service
Wants=network-online.target
Conflicts=ig-handle-xsens.service
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GRANDE_WORKSPACE_SETUP=%h/catkin_ws/heron_ws/install-native/setup.bash
EnvironmentFile=-%h/.config/grande/environment
ExecStart=/bin/bash -lc 'set -Ee -o pipefail; source /opt/ros/noetic/setup.bash; if [ -r "$${GRANDE_WORKSPACE_SETUP}" ]; then source "$${GRANDE_WORKSPACE_SETUP}"; fi; exec rosrun ig_handle external_sensor_provider.py --sensor-id 1 --profile physical'
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target ig-handle-roscore-user.service
